{
  "name": "hh3-army-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rules model, validator and tests for a Horus Heresy 3.0 army builder (pre-UI).",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:bsdata": "node scripts/import-bsdata.ts",
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
